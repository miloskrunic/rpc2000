---
import { Image } from 'astro:assets';
import ButtonLabel from '../ui/ButtonLabel.astro';
import detail from '../../assets/images/turning-detail.jpg';
import { services } from '../../data/company';
---
<section class="section services-section" id="usluge" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow"><span></span>01 / NAŠE USLUGE</p><h2 id="services-title">Od jednog komada.<br /><span class="muted-heading">Do cele serije.</span></h2></div>
      <p class="section-intro">Četiri postupka obrade. Jedan pristup poslu.<br />Za novi deo, završnu obradu ili serijsku izradu. Pošaljite opis posla ili tehničku dokumentaciju.</p>
    </div>
    <div class="services-layout">
      <div class="service-list" data-reveal>
        {services.map((service, index) => (
          <details class="service" id={`usluga-${service.id}`} data-service open={index === 0}>
            <summary><span class="service-number">{service.number}</span><h3>{service.title}</h3><span class="service-toggle" aria-hidden="true"></span></summary>
            <div class="service-content"><p>{service.description}</p><a class="button button-secondary service-inquiry" href="#kontakt" data-inquiry-service={service.id}><ButtonLabel text="Upit za ovu uslugu" /></a><span class="service-tag">{service.tag}</span></div>
          </details>
        ))}
      </div>
      <figure class="services-figure" data-reveal="media">
        <Image src={detail} alt="Ilustrativna fotografija metalnog komada i alata tokom obrade na strugu" widths={[480, 720, 1000]} sizes="(max-width: 488px) calc(100vw - 44px), (max-width: 600px) 91vw, (max-width: 800px) calc(40.45vw - 13.33px), (max-width: 1100px) calc(41.36vw - 18.18px), min(550px, calc(41.36vw - 32.73px))" width={700} height={860} fit="cover" format="webp" loading="lazy" />
        <span class="photo-cross photo-cross-top" aria-hidden="true">+</span><span class="photo-cross photo-cross-bottom" aria-hidden="true">+</span>
        <figcaption><span>OBRADA NA STRUGU</span><span>Ilustrativna fotografija</span></figcaption>
      </figure>
    </div>
  </div>
</section>
