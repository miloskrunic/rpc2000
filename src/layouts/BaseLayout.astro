---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/manrope';
import bodyFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import brandFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { company } from '../data/company';
import { getImage } from 'astro:assets';
import hero from '../assets/images/hero-lathe.png';
import { indexingEnabled, siteUrl, homepageUrl } from '../../site.config.mjs';

interface Props { title?: string; description?: string; noindex?: boolean }
const {
  title = company.title,
  description = company.description,
  noindex = false,
} = Astro.props;
const canIndex = indexingEnabled && !noindex;
const canonical = canIndex && siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const shareImage = canonical ? await getImage({ src: hero, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : undefined;
const shareImageUrl = shareImage && siteUrl ? new URL(shareImage.src, siteUrl).href : undefined;
const structuredData = canonical && Astro.url.pathname === import.meta.env.BASE_URL ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${homepageUrl}#organization`, name: company.name, url: homepageUrl, description: company.description },
    { '@type': 'WebSite', '@id': `${homepageUrl}#website`, name: company.name, url: homepageUrl, inLanguage: 'sr-Latn', publisher: { '@id': `${homepageUrl}#organization` } },
  ],
} : undefined;
---
<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={canIndex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#111315" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={company.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImageUrl && <>
      <meta property="og:image" content={shareImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Ilustracija obrade metala na strugu. RPC2000" />
      <meta name="twitter:image" content={shareImageUrl} />
      <meta name="twitter:image:alt" content="Ilustracija obrade metala na strugu. RPC2000" />
    </>}
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={brandFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#sadrzaj">Preskoči na sadržaj</a>
    <Header />
    <main id="sadrzaj" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
